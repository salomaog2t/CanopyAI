# Copy to .streamlit/secrets.toml for local testing, or paste into
# Streamlit Community Cloud → App → Settings → Secrets. Never commit the real file.

GEE_PROJECT_ID = "your-gcp-project-id"   # project registered for Earth Engine
CANOPYAI_ALLOW_CUSTOM = "1"               # "0" disables new Earth Engine downloads (demo cities only)
CANOPYAI_MAX_DOWNLOADS = "3"              # new custom areas per browser session

# Service-account key: every field of the downloaded JSON key, one per line.
# Generate this block from the JSON with:  python scripts/key_to_toml.py path/to/key.json
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "canopyai-app@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
